@page
@model MultiplicationGame.Pages.EquationsModel
@{
    ViewData["Title"] = "Równania";
}

<div class="container" style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="text-center">
                <h1 class="h3 mb-3">Równania</h1>

                <form method="post" asp-page-handler="Generate" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TotalAnswered" value="@Model.TotalAnswered" />
                    <input type="hidden" name="A" value="@Model.A" />
                    <input type="hidden" name="B" value="@Model.B" />
                    <input type="hidden" name="Operator" value="@Model.Operator" />
                    <input type="hidden" name="UserAnswer" value="@Model.UserAnswer" />
                    <input type="hidden" name="HistoryRaw" value='@Model.HistoryRaw' />

                    <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                        <label for="difficulty" class="fw-semibold">Poziom trudności:</label>
                        <select id="difficulty"
                                name="Difficulty"
                                class="form-select"
                                style="width: auto;"
                                onchange="this.form.submit()">
                            <option value="1" selected="@(Model.Difficulty == "1")">Klasa 1</option>
                            <option value="2" selected="@(Model.Difficulty == "2")">Klasa 2</option>
                            <option value="3" selected="@(Model.Difficulty == "3")">Klasa 3</option>
                        </select>
                    </div>
                    <noscript>
                        <button type="submit" class="btn btn-outline-primary mt-2">Zmień poziom</button>
                    </noscript>
                </form>

                @if (!Model.GameFinished)
                {
                    <form method="post" asp-page-handler="Submit" class="question-form" id="equationsAnswerForm" style="max-width: 720px; margin: 0 auto;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Difficulty" value="@Model.Difficulty" />
                        <input type="hidden" name="A" value="@Model.A" />
                        <input type="hidden" name="B" value="@Model.B" />
                        <input type="hidden" name="Operator" value="@Model.Operator" />
                        <input type="hidden" name="TotalAnswered" value="@Model.TotalAnswered" />
                        <input type="hidden" name="HistoryRaw" value='@Model.HistoryRaw' />

                        @if (Model.ModelState.TryGetValue("UserAnswer", out var userAnswerErrors) &&
                             userAnswerErrors.Errors.Count > 0)
                        {
                            <div class="alert alert-danger text-start" role="alert">
                                <strong>Błąd walidacji:</strong>
                                @foreach (var error in userAnswerErrors.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="d-flex align-items-center justify-content-center gap-2 my-3 flex-wrap">
                            <div class="display-3 operand-display border border-primary rounded-4 bg-light shadow-sm d-flex align-items-center justify-content-center" style="width:80px;height:80px;">@Model.A</div>
                            <div class="display-3 fw-bold">@Model.Operator</div>
                            <div class="display-3 operand-display border border-primary rounded-4 bg-light shadow-sm d-flex align-items-center justify-content-center" style="width:80px;height:80px;">@Model.B</div>
                            <div class="display-3 fw-bold">=</div>
                            <div class="display-3 operand-display border border-primary rounded-4 bg-light shadow-sm d-flex align-items-center justify-content-center" style="width:110px;height:80px;">
                                <input type="text"
                                       name="UserAnswer"
                                       value="@Model.UserAnswer"
                                       class="form-control equation-input numeric-input"
                                       autocomplete="off"
                                       inputmode="decimal"
                                       required
                                       pattern="-?(?:[0-9]+(?:[.,][0-9]+)?|[.,][0-9]+)"
                                       title="Wpisz liczbę (może być ułamek dziesiętny, dopuszczalne . lub ,)"
                                       style="height:100%; border:0; background:transparent; box-shadow:none; font-size:2.2rem;" />
                            </div>
                        </div>

                        @if (Model.AnswerChecked)
                        {
                            if (Model.IsCorrect)
                            {
                                <div class="alert alert-success">Dobrze!</div>
                            }
                            else
                            {
                                <div class="alert alert-danger">Niepoprawnie. Poprawna odpowiedź: @Model.CorrectAnswer</div>
                            }
                        }

                        <div class="d-flex justify-content-center gap-2">
                            @if (!Model.AnswerChecked)
                            {
                                <button type="submit" class="btn btn-primary">Sprawdź</button>
                            }
                            else
                            {
                                <input type="hidden" name="NextQuestion" value="true" />
                                <button type="submit" class="btn btn-secondary">Następne pytanie</button>
                            }
                        </div>
                    </form>
                }
                else
                {
                    <div class="card p-4 text-start">
                        <h2 class="h3 text-center mb-3">Podsumowanie</h2>
                        <ul class="list-group mb-3">
                            @foreach (var h in Model.History)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center @(h.IsCorrect ? "list-group-item-success" : "list-group-item-danger")">
                                    <span class="fw-bold">@h.Text</span>
                                    @if (h.IsCorrect)
                                    {
                                        <span>Poprawnie</span>
                                    }
                                    else
                                    {
                                        <span>Błąd — prawidłowo: @h.Correct</span>
                                    }
                                </li>
                            }
                        </ul>
                        <form method="post" asp-page-handler="Generate" class="text-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Difficulty" value="@Model.Difficulty" />
                            <button type="submit" class="btn btn-primary">Zacznij ponownie</button>
                        </form>
                    </div>
                }

                <div class="progress-panel mx-auto mt-3">
                    <h6 class="text-center mb-2">Postęp</h6>
                    <div class="progress-grid">
                        @for (var i = 1; i <= Model.RequiredAnswers; i++)
                        {
                            var entry = i <= Model.History.Count ? Model.History[i - 1] : null;
                            var isCurrent = i == Model.History.Count + 1 && !Model.GameFinished;
                            var statusClass = entry is not null
                                ? entry.IsCorrect ? "completed" : "incorrect"
                                : isCurrent ? "current" : "";
                            var statusText = entry is not null
                                ? entry.IsCorrect ? "Poprawna odpowiedź" : "Błędna odpowiedź"
                                : isCurrent ? "Bieżące pytanie" : "Jeszcze nie rozwiązano";

                            <div class="progress-square @statusClass" title="@($"{i}: {statusText}")">
                                @i
                            </div>
                        }
                    </div>
                    <div class="text-center mt-2">
                        <small class="text-muted">@Model.History.Count/@Model.RequiredAnswers ukończone</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Focus answer on load
setTimeout(() => {
  const inp = document.querySelector('input[name="UserAnswer"]');
  if (inp) inp.focus();
}, 0);

// Guard against double-submit - reset after answer checked
(function(){
    const form = document.getElementById('equationsAnswerForm');
    if (!form) return;
    
    // Check if we're showing "Następne pytanie" button and reset guard
    const nextQuestionField = form.querySelector('input[name="NextQuestion"][value="true"]');
    if (nextQuestionField) {
        form.dataset.submitted = 'false';
        // Re-enable buttons
        const btns = form.querySelectorAll('button[type="submit"]');
        btns.forEach(b => b.removeAttribute('disabled'));
    }
    
    form.addEventListener('submit', function(e){
        // Double-submit prevention only (validation handled by site.js submit guard)
        if (form.dataset.submitted === 'true') {
            e.preventDefault();
            return false;
        }
        form.dataset.submitted = 'true';
        const btns = form.querySelectorAll('button[type="submit"]');
        btns.forEach(b => b.setAttribute('disabled','disabled'));
    });
})();
</script>
